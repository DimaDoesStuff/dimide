	"tokenColors": [
		{
			"scope": ["comment", "punctuation.definition.comment", "string.comment"],
			"settings": { "foreground": "#808080", "fontStyle": "italic" }
		},
		{
			"scope": ["constant", "entity.name.constant", "variable.other.constant", "variable.other.enummember", "variable.language", "support.constant"],
			"settings": { "foreground": "#660E7A" }
		},
		{
			"scope": ["entity", "entity.name", "meta.export.default", "meta.definition.variable"],
			"settings": { "foreground": "#2B2B2B" }
		},
		{
			"scope": ["entity.name.class", "entity.name.type.class", "support.class"],
			"settings": { "foreground": "#2B2B2B", "fontStyle": "bold" }
		},
		{
			"scope": "entity.name.function",
			"settings": { "foreground": "#7A7A43" }
		},
		{
			"scope": ["entity.name.tag", "support.class.component"],
			"settings": { "foreground": "#7A7A43" }
		},
		{
			"scope": ["entity.name.type", "support.type"],
			"settings": { "foreground": "#2B2B2B", "fontStyle": "bold" }
		},
		{
			"scope": ["keyword", "storage", "storage.type"],
			"settings": { "foreground": "#0033B3", "fontStyle": "bold" }
		},
		{
			"scope": ["storage.modifier.package", "storage.modifier.import", "storage.type.java"],
			"settings": { "foreground": "#2B2B2B" }
		},
		{
			"scope": ["string", "string punctuation.section.embedded source"],
			"settings": { "foreground": "#067D17" }
		},
		{
			"scope": "support",
			"settings": { "foreground": "#7C7CFF" }
		},
		{
			"scope": "meta.property-name",
			"settings": { "foreground": "#660E7A" }
		},
		{
			"scope": "variable",
			"settings": { "foreground": "#2B2B2B" }
		},
		{
			"scope": ["variable.parameter", "variable.parameter.function"],
			"settings": { "foreground": "#2B2B2B" }
		},
		{
			"scope": "variable.other",
			"settings": { "foreground": "#2B2B2B" }
		},
		{
			"scope": ["invalid.broken", "invalid.deprecated", "invalid.illegal", "invalid.unimplemented"],
			"settings": { "foreground": "#C41E3A", "fontStyle": "italic" }
		},
		{
			"scope": ["source.regexp", "string.regexp"],
			"settings": { "foreground": "#067D17" }
		},
		{
			"scope": ["string.regexp.character-class", "string.regexp constant.character.escape", "string.regexp source.ruby.embedded"],
			"settings": { "foreground": "#067D17" }
		},
		{
			"scope": "string.regexp constant.character.escape",
			"settings": { "foreground": "#067D17", "fontStyle": "bold" }
		},
		{
			"scope": ["support.type.property-name.json"],
			"settings": { "foreground": "#660E7A" }
		},
		{
			"scope": "meta.module-reference",
			"settings": { "foreground": "#660E7A" }
		},
		{
			"scope": ["punctuation.definition.list.begin.markdown"],
			"settings": { "foreground": "#7A7A43" }
		},
		{
			"scope": ["markup.heading", "markup.heading entity.name"],
			"settings": { "foreground": "#660E7A", "fontStyle": "bold" }
		},
		{
			"scope": "markup.quote",
			"settings": { "foreground": "#067D17" }
		},
		{
			"scope": "markup.italic",
			"settings": { "foreground": "#2B2B2B", "fontStyle": "italic" }
		},
		{
			"scope": "markup.bold",
			"settings": { "foreground": "#2B2B2B", "fontStyle": "bold" }
		},
		{
			"scope": "markup.inline.raw",
			"settings": { "foreground": "#660E7A" }
		},
		{
			"scope": ["markup.deleted", "meta.diff.header.from-file", "punctuation.definition.deleted"],
			"settings": { "foreground": "#C41E3A" }
		},
		{
			"scope": ["markup.inserted", "meta.diff.header.to-file", "punctuation.definition.inserted"],
			"settings": { "foreground": "#4CAF50" }
		},
		{
			"scope": ["markup.changed", "punctuation.definition.changed"],
			"settings": { "foreground": "#D4A017" }
		},
		{
			"scope": ["punctuation.section.embedded"],
			"settings": { "foreground": "#0033B3" }
		},
		{
			"scope": "meta.diff.range",
			"settings": { "foreground": "#660E7A", "fontStyle": "bold" }
		},
		{
			"scope": "meta.diff.header",
			"settings": { "foreground": "#7C7CFF" }
		},
		{
			"scope": "meta.separator",
			"settings": { "foreground": "#660E7A", "fontStyle": "bold" }
		},
		{
			"scope": ["brackethighlighter.tag", "brackethighlighter.curly", "brackethighlighter.round", "brackethighlighter.square"],
			"settings": { "foreground": "#999999" }
		},
		{
			"scope": "brackethighlighter.unmatched",
			"settings": { "foreground": "#C41E3A" }
		},
		{
			"scope": ["constant.other.reference.link", "string.other.link"],
			"settings": { "foreground": "#7C7CFF" }
		},
		{
			"scope": "token.info-token",
			"settings": { "foreground": "#7C7CFF" }
		},
		{
			"scope": "token.warn-token",
			"settings": { "foreground": "#D4A017" }
		},
		{
			"scope": "token.error-token",
			"settings": { "foreground": "#C41E3A" }
		},
		{
			"scope": "token.debug-token",
			"settings": { "foreground": "#660E7A" }
		}
	],
	"semanticHighlighting": true
}
